# --- App / auth ---
# Shared secret for browser access (Bearer header, ?token=, or access_token cookie)
ACCESS_TOKEN=change-me
# Web UI host port (Docker maps this → container 3000). Avoid 8081 (Grafana).
PORT=8090
STREAM_TIMEOUT_SEC=120

# --- Camera identity (server-side only; never sent to the browser) ---
DEVICE_ID=89370567
CAMERA_USERNAME=admin
CAMERA_PASSWORD=
SOURCE=cloud
# CAMERA_IP=192.168.1.50
# CAMERA_PORT=8800

# --- Modes ---
# MOCK_CAMERA=1  → generated test-pattern MJPEG (no real camera / decoder needed)
# MOCK_CAMERA=0  → proxy to V380Decoder at DECODER_URL when CAMERA_PASSWORD is set
MOCK_CAMERA=0
# Node / host: point at published decoder HTTP port (default 18080)
DECODER_URL=http://127.0.0.1:18080
# Docker compose (real profile, same network): DECODER_URL=http://v380decoder:8080

# Optional published decoder ports (docker-compose real profile)
# DECODER_HTTP_PORT=18080
# DECODER_RTSP_PORT=18554

# Optional: bind UI cookie domain / HTTPS behind reverse proxy
# TRUST_PROXY=1
